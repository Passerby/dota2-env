# API keys for the LLM match. Copy this file to .env (gitignored) and fill in what your config uses:
#   cp .env.example .env
# examples/llm_match.py reads .env on start; a match YAML refers to a key as ${DEEPSEEK_API_KEY}.
# A variable already exported in the shell wins over the value here.
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
DASHSCOPE_API_KEY=
